---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import TableOfContents from "../../components/layout/TableOfContents.astro";

type Writing = CollectionEntry<"writings">;

export async function getStaticPaths() {
  const writings: Writing[] = await getCollection(
    "writings",
    ({ data }: { data: Writing["data"] }) =>
      import.meta.env.PROD ? data.draft !== true : true,
  );

  return writings
    .filter((post: Writing) => !post.data.external_url)
    .sort(
      (a: Writing, b: Writing) => b.data.date.valueOf() - a.data.date.valueOf(),
    )
    .map((post: Writing) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

interface Props {
  post: Writing;
}

const { post } = Astro.props as Props;
const { title, description, date, tags } = post.data;
const { Content, headings } = await render(post);

const formattedDate = date.toLocaleDateString("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
});
---

<Layout title={title} description={description} mainClass="px-6 py-6">
  <div
    class="mx-auto grid w-full max-w-[1120px] grid-cols-1 gap-10 pt-2 lg:grid-cols-[minmax(0,760px)_280px] lg:items-start"
  >
    <article class="min-w-0">
      <header class="mb-9">
        <h1
          class="mb-4 text-4xl font-black leading-[1.05] text-ink md:text-6xl"
        >
          {title}
        </h1>

        <div class="flex flex-col gap-2 text-sm text-muted">
          {
            tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                {tags.map((tag: string) => (
                  <span class="bg-primary-200 px-2 py-0.5 text-xs font-medium text-primary-600 dark:bg-secondary-900 dark:text-secondary-300">
                    {tag}
                  </span>
                ))}
              </div>
            )
          }
          <span>
            Published on <time
              datetime={date.toISOString()}
              class="font-semibold text-ink">{formattedDate}</time
            >
          </span>
        </div>
      </header>

      <div class="writing-content">
        <Content />
      </div>
    </article>

    {headings.length > 0 && (
      <aside class="hidden self-start lg:sticky lg:top-[78px] lg:block">
        <TableOfContents {headings} />
      </aside>
    )}
  </div>
</Layout>
