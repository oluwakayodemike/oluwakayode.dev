---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import TableOfContents from "../../components/layout/TableOfContents.astro";
import externalLinkIcon from "../../icons/external-link.svg?raw";

import H1 from "../../components/mdx/H1.astro";
import H2 from "../../components/mdx/H2.astro";
import H3 from "../../components/mdx/H3.astro";
import H4 from "../../components/mdx/H4.astro";
import Code from "../../components/mdx/Code.astro";

type Writing = CollectionEntry<"writings">;

export async function getStaticPaths() {
  const writings: Writing[] = await getCollection(
    "writings",
    ({ data }: { data: Writing["data"] }) =>
      import.meta.env.PROD ? data.draft !== true : true,
  );

  return writings
    .sort(
      (a: Writing, b: Writing) => b.data.date.valueOf() - a.data.date.valueOf(),
    )
    .map((post: Writing) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

interface Props {
  post: Writing;
}

const { post } = Astro.props as Props;
const { title, description, date, tags, external_url } = post.data;
const { Content, headings } = await render(post);

const formattedDate = date.toLocaleDateString("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
});

const externalHost = external_url
  ? new URL(external_url).hostname.replace(/^www\./, "")
  : null;
---

<Layout title={title} description={description} mainClass="px-6 py-6">
  <div
    class="mx-auto grid w-full max-w-[1120px] grid-cols-1 gap-10 pt-2 lg:grid-cols-[minmax(0,760px)_280px] lg:items-start"
  >
    <article class="min-w-0">
      <header class="mb-9">
        <h1
          class="mb-4 font-inter text-4xl font-bold leading-[1.05] text-ink md:text-6xl"
        >
          {title}
        </h1>

        <div class="flex flex-col gap-2 text-sm text-muted">
          {
            tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                {tags.map((tag: string) => (
                  <span class="bg-primary-200 px-2 py-0.5 text-xs font-medium text-primary-600 dark:bg-secondary-900 dark:text-secondary-300">
                    {tag}
                  </span>
                ))}
              </div>
            )
          }
          {
            external_url && (
              <a
                href={external_url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-fit items-center gap-1.5 text-sm font-medium text-muted underline underline-offset-4 transition-colors hover:text-primary-400"
                aria-label={`Read the original article on ${externalHost}`}
              >
                <span
                  class="inline-flex opacity-70 [&>svg]:h-3.5 [&>svg]:w-3.5"
                  set:html={externalLinkIcon}
                />
                Read original on {externalHost}
              </a>
            )
          }
          <span>
            Published on <time
              datetime={date.toISOString()}
              class="font-semibold text-ink">{formattedDate}</time
            >
          </span>
        </div>
      </header>

      {
        headings.length > 0 && (
          <div class="mb-8 lg:hidden">
            <TableOfContents headings={headings} variant="mobile" />
          </div>
        )
      }

      <div class="writing-content">
        <Content components={{ h1: H1, h2: H2, h3: H3, h4: H4, pre: Code }} />
      </div>
    </article>

    {
      headings.length > 0 && (
        <aside class="hidden self-start lg:sticky lg:top-[78px] lg:block">
          <TableOfContents headings={headings} />
        </aside>
      )
    }
  </div>
</Layout>
