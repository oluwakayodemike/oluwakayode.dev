---
import { Image } from "astro:assets";
import myAvatar from "../assets/avatar.png";
---

<div class="mb-8 flex items-center justify-between">
  <div class="flex items-center gap-5">
    <div
      class="h-[72px] w-[72px] shrink-0 overflow-hidden rounded-2xl border border-line"
    >
      <Image
        src={myAvatar}
        alt="Oluwakayode"
        class="block h-full w-full object-cover object-center"
        width="72"
        height="72"
      />
    </div>
    <div>
      <h1 class="text-base font-semibold text-ink">
        Michael Kayode Oluwasegun
      </h1>
      <p
        id="live-line"
        class="text-sm font-medium text-muted tabular-nums mt-1"
      >
      </p>
      <a
        href="mailto:michaelaykay@gmail.com"
        aria-label="Email"
        class="text-sm text-muted transition-colors hover:text-primary-400"
      >
        michaelaykay@gmail.com
      </a>
    </div>
  </div>
</div>

<div class="space-y-5 text-sm leading-[1.85] text-ink/80">
  <p>
    Hey, I'm Michael, a software engineer and undergraduate at the Federal
    University of Technology, Akure.
  </p>
  <p>
    I like to craft solid and scalable products with exceptional user
    experiences, focusing on innovation and problem-solving. I care deeply about
    what I build and how it performs. Things being fast matters to me, and
    lately I've been exploring local-first tools and what they could mean for
    how we build software going forward.
  </p>
  <p>
    I write too, about things that genuinely interest me. Not on a schedule,
    just whenever the zeal strikes. I'm currently learning Python and always
    finding new things to dig into.
  </p>
  <p>
    Outside writing code, I spend time learning about finance, playing chess,
    and interesting myself with random facts and information across different
    fields. I find that the curiosity that makes me good at one thing tends to
    feed everything else.
  </p>
</div>

<hr class="my-6 border-line" />

<div>
  <h2 class="mb-4 text-sm font-semibold text-ink">Find me online</h2>
  <ul class="space-y-2.5 text-sm">
    <li>
      <a
        href="https://github.com/oluwakayodemike"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-muted no-underline transition-colors hover:text-primary-400"
      >
        GitHub <span class="text-line">/</span> oluwakayodemike
      </a>
    </li>
    <li>
      <a
        href="https://x.com/trulymko"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X (Twitter)"
        class="text-muted no-underline transition-colors hover:text-primary-400"
      >
        X (Twitter) <span class="text-line">/</span> trulymko
      </a>
    </li>
    <li>
      <a
        href="https://linkedin.com/in/oluwakayodemike"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-muted no-underline transition-colors hover:text-primary-400"
      >
        LinkedIn <span class="text-line">/</span> oluwakayodemike
      </a>
    </li>
    <li>
      <a
        href="mailto:michaelaykay@gmail.com"
        aria-label="Email"
        class="text-muted no-underline transition-colors hover:text-primary-400"
      >
        Email <span class="text-line">/</span> michaelaykay@gmail.com
      </a>
    </li>
  </ul>
</div>

<script>
  function updateTime() {
    const el = document.getElementById("live-line");
    if (!el) return;
    const time = new Date().toLocaleTimeString("en-US", {
      timeZone: "Africa/Lagos",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
    });
    el.textContent = `${time} - Lagos, Nigeria`;
  }
  updateTime();
  setInterval(updateTime, 1000);
</script>
