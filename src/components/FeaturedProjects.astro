---
import projectsData from '../data/projects.json'

const projects = projectsData
  .filter((p) => p.status === 'active')
  .slice(0, 3)
---

<section class="py-10">
  <span class="mb-3 flex items-center gap-2 text-[0.8rem] tracking-wide text-muted">
    <span class="h-[7px] w-[7px] shrink-0 rounded-full bg-secondary-400 dark:bg-secondary-500" aria-hidden="true"></span>
    Projects
  </span>

  <ul role="list" class="divide-y divide-line">
    {projects.map((project) => (
      <li class="py-4">
        <div class="min-w-0">
          <div class="mb-1 flex items-center gap-2.5">
            <h3 class="text-[0.95rem] font-medium text-ink">{project.name}</h3>
            <div class="flex items-center gap-2">
              {project.github_url && (
                <a
                  href={project.github_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.name} on GitHub`}
                  class="text-muted transition-colors hover:text-ink"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                </a>
              )}
              {project.website_url && (
                <a
                  href={project.website_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.name} live site`}
                  class="text-muted transition-colors hover:text-ink"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                </a>
              )}
            </div>
          </div>

          <p class="mb-2.5 text-[0.85rem] leading-relaxed text-muted">
            {project.description}
          </p>

          <div class="flex flex-wrap gap-1.5">
            {project.tags.map((tag) => (
              <span class="rounded-md bg-secondary-100 px-2 py-0.5 text-[0.7rem] font-medium text-secondary-600 dark:bg-secondary-900 dark:text-secondary-400">
                {tag}
              </span>
            ))}
          </div>

        </div>
      </li>
    ))}
  </ul>

  <div class="mt-3 flex justify-end">
    <a href="/projects" class="text-[0.8rem] text-muted underline underline-offset-4 transition-colors hover:text-ink">
      View all projects →
    </a>
  </div>

</section>