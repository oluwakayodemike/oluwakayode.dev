---
import projectsData from "../data/projects.json";
import githubIcon from "../icons/github.svg?raw";
import externalLinkIcon from "../icons/external-link.svg?raw";

const projects = projectsData.filter((p) => p.status === "active").slice(0, 3);
---

<section class="py-10">
  <span class="mb-3 flex items-center gap-2 text-sm tracking-wide text-muted">
    <span
      class="h-[7px] w-[7px] shrink-0 rounded-full bg-secondary-400 dark:bg-secondary-500"
      aria-hidden="true"></span>
    Projects
  </span>

  <ul role="list" class="divide-y divide-line">
    {
      projects.map((project) => {
        const projectLink = project.website_url || project.github_url;

        return (
          <li class="py-5">
            <div class="min-w-0">
              <div class="mb-1.5 flex items-center gap-2.5">
                <h3 class="text-base font-medium text-ink">
                  {projectLink ? (
                    <a
                      href={projectLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="transition-colors hover:text-primary-400 no-underline"
                    >
                      {project.name}
                    </a>
                  ) : (
                    <span class="transition-colors hover:text-primary-400 cursor-default">
                      {project.name}
                    </span>
                  )}
                </h3>

                <div class="flex items-center gap-2">
                  {project.github_url && (
                    <a
                      href={project.github_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${project.name} on GitHub`}
                      class="text-muted transition-colors hover:text-primary-400"
                    >
                      <span
                        class="flex items-center justify-center [&>svg]:w-3.5 [&>svg]:h-3.5"
                        set:html={githubIcon}
                      />
                    </a>
                  )}
                  {project.website_url && (
                    <a
                      href={project.website_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${project.name} live site`}
                      class="text-muted transition-colors hover:text-primary-400"
                    >
                      <span
                        class="flex items-center justify-center [&>svg]:w-3.5 [&>svg]:h-3.5"
                        set:html={externalLinkIcon}
                      />
                    </a>
                  )}
                </div>
              </div>

              <p class="mb-3 text-sm leading-relaxed text-muted">
                {project.description}
              </p>

              <div class="flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="bg-primary-200 px-2 py-0.5 text-xs font-medium text-primary-600 dark:bg-secondary-900 dark:text-secondary-300">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>

  <div class="mt-4 flex justify-end">
    <a
      href="/projects"
      class="text-sm text-muted underline underline-offset-4 transition-colors hover:text-primary-400"
    >
      View all projects →
    </a>
  </div>
</section>
