---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ArticleListItem from "./items/ArticleListItem.astro";

const posts = await getCollection(
  "writings",
  ({ data }: { data: CollectionEntry<"writings">["data"] }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  },
);

const publishedPosts = posts.sort(
  (a: CollectionEntry<"writings">, b: CollectionEntry<"writings">) =>
    b.data.date.valueOf() - a.data.date.valueOf(),
);

let postsByYear: Record<string, Array<CollectionEntry<"writings">>> = {};
for (const post of publishedPosts) {
  const year = post.data.date.getFullYear().toString();
  if (!postsByYear[year]) postsByYear[year] = [];
  postsByYear[year].push(post);
}

const years = Object.keys(postsByYear).sort(
  (a, b) => parseInt(b) - parseInt(a),
);
---

<section class="max-w-[720px]">
  <header class="mb-10">
    <h1 class="mb-2 text-2xl font-bold text-ink">Writings</h1>
    <p class="text-[16px] md:text-md leading-[1.8] text-ink/80 max-w-2xl">
      This is where I document what I’m learning, building, or simply
      overthinking. Here you'll see a mix of technical notes, solutions to weird
      bugs, and occasionally, random thoughts that have absolutely nothing to do
      with code or tech as a whole. I have no rigid schedules here, just writing
      when the inspiration hits.
    </p>
  </header>

  <div class="flex flex-col gap-12">
    {
      years.map((year) => (
        <div id={`year-${year}`} class="relative md:flex md:gap-8 items-start">
          <h2 class="text-2xl md:text-3xl font-bold text-muted md:w-24 shrink-0 md:sticky md:top-12 mb-2 md:mb-0 pt-1">
            {year}
          </h2>

          <div class="flex-1 flex flex-col w-full border-t border-line md:border-none pt-4 md:pt-0">
            {postsByYear[year].map((post) => (
              <ArticleListItem post={post} />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
