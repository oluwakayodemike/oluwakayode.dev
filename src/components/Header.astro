---
import moonIcon from "../icons/moon.svg?raw";
import sunIcon from "../icons/sun.svg?raw";
import menuIcon from "../icons/menu.svg?raw";
import closeIcon from "../icons/close.svg?raw";

const navLinks = [
  { label: "home", href: "/" },
  { label: "about", href: "/about" },
  { label: "projects", href: "/projects" },
  { label: "writings", href: "/writings" },
  { label: "tools", href: "/tools" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="w-full sticky top-0 z-50 border-b border-line backdrop-blur-sm"
  style="background-color: color-mix(in srgb, var(--bg) 92%, transparent);"
>
  <nav class="container flex h-[54px] items-center justify-between">
    <a
      href="/"
      aria-label="mko — home"
      class="font-display text-[1.35rem] font-semibold tracking-tight text-ink no-underline shrink-0 transition-opacity hover:opacity-70"
    >
      mko
    </a>

    <ul role="list" class="hidden sm:flex items-center list-none gap-6">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "text-sm no-underline tracking-wide transition-colors duration-100",
                currentPath === link.href ||
                (link.href !== "/" && currentPath.startsWith(link.href))
                  ? "text-ink font-medium"
                  : "text-muted hover:text-ink",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="flex shrink-0 cursor-pointer items-center justify-center rounded-md border-none bg-transparent p-1.5 text-muted transition-all hover:text-ink hover:bg-secondary-100 dark:hover:bg-secondary-900"
      >
        <span
          class="icon-moon flex items-center justify-center"
          set:html={moonIcon}
        />
        <span
          class="icon-sun flex items-center justify-center"
          set:html={sunIcon}
        />
      </button>

      <button
        id="menu-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="sm:hidden flex items-center justify-center p-1.5 rounded-md text-muted hover:text-ink border-none bg-transparent cursor-pointer transition-colors"
      >
        <span
          id="icon-menu"
          class="flex items-center justify-center"
          set:html={menuIcon}
        />
        <span
          id="icon-close"
          class="hidden items-center justify-center"
          set:html={closeIcon}
        />
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="hidden sm:hidden border-t border-line"
    style="background-color: color-mix(in srgb, var(--bg) 97%, transparent);"
  >
    <ul role="list" class="container flex flex-col py-4 list-none">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block py-3 text-[0.95rem] tracking-wide no-underline border-b border-line transition-colors",
                currentPath === link.href ||
                (link.href !== "/" && currentPath.startsWith(link.href))
                  ? "text-ink font-medium"
                  : "text-muted hover:text-ink",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .icon-sun {
    display: none;
  }
  .icon-moon {
    display: flex;
  }
  :global(.dark) .icon-sun {
    display: flex;
  }
  :global(.dark) .icon-moon {
    display: none;
  }
</style>

<script>
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  menuToggle?.addEventListener("click", () => {
    const willOpen = mobileMenu?.classList.contains("hidden");

    mobileMenu?.classList.toggle("hidden", !willOpen);
    iconMenu?.classList.toggle("hidden", willOpen);
    iconClose?.classList.toggle("hidden", !willOpen);

    menuToggle.setAttribute("aria-expanded", String(willOpen));
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");
      iconMenu?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      menuToggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
