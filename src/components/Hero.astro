      <span
        class="h-[7px] w-[7px] shrink-0 rounded-full bg-secondary-400 dark:bg-secondary-500"
        aria-hidden="true"></span>
      Software Engineer
    </span>
    <span
      class="badge flex items-center gap-1.5 rounded-full border px-3 py-1 text-[0.7rem] font-medium uppercase tracking-widest"
    >
      <span
        class="badge-dot h-1.5 w-1.5 shrink-0 rounded-full"
        aria-hidden="true"></span>
