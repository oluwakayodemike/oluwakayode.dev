---
import arrowRightIcon from "../icons/arrow-right.svg?raw";
import githubIcon from "../icons/github.svg?raw";
import xIcon from "../icons/x.svg?raw";
import linkedinIcon from "../icons/linkedin.svg?raw";
import emailIcon from "../icons/email.svg?raw";
---

<section class="md:pt-10 pb-12">
  <div
    class="grid grid-cols-1 md:grid-cols-[1fr_280px] gap-6 md:gap-16 items-center"
  >
    <div class="min-w-0 order-last md:order-first">
      <div class="mb-5">
        <span
          class="badge inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium uppercase tracking-widest"
        >
          <span
            class="badge-dot h-1.5 w-1.5 shrink-0 rounded-full"
            aria-hidden="true"></span>
          Open to opportunities
        </span>
      </div>

      <p
        class="mb-1 text-sm font-medium text-primary-400 dark:text-primary-300"
      >
        Hello, I'm
      </p>
      <h1
        class="mb-3 font-sans font-extrabold leading-[1.05] tracking-tight text-ink hero-name"
      >
        Oluwakayode.
      </h1>

      <p class="mb-5 flex items-center gap-2 text-sm text-muted">
        <span class="font-medium text-ink">Software Engineer</span>
        <span class="text-line" aria-hidden="true">·</span>
        <span>Lagos, Nigeria</span>
      </p>

      <p class="mb-8 text-sm leading-[1.8] text-muted">
        2+ years building on the web, with a strong pull toward backend systems
        and the kind of problems that take a while to figure out. When I'm not
        coding, I'm learning about finance, playing chess, or doing mental math
        — actually for fun.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 rounded-lg bg-ink px-5 py-2.5 text-sm font-medium text-surface no-underline transition-all hover:opacity-85"
        >
          See my work
          <span
            class="flex items-center justify-center"
            set:html={arrowRightIcon}
          />
        </a>

        <span class="hidden h-5 w-px bg-line sm:block" aria-hidden="true"
        ></span>

        <div class="flex items-center gap-3">
          <a
            href="https://github.com/oluwakayodemike"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-muted transition-colors hover:text-ink"
          >
            <span
              class="flex items-center justify-center"
              set:html={githubIcon}
            />
          </a>

          <a
            href="https://x.com/trulymko"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X / Twitter"
            class="text-muted transition-colors hover:text-ink"
          >
            <span class="flex items-center justify-center" set:html={xIcon} />
          </a>

          <a
            href="https://linkedin.com/in/oluwakayodemike"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-muted transition-colors hover:text-ink"
          >
            <span
              class="flex items-center justify-center"
              set:html={linkedinIcon}
            />
          </a>

          <a
            href="mailto:michaelaykay@gmail.com"
            aria-label="Email"
            class="text-muted transition-colors hover:text-ink"
          >
            <span
              class="flex items-center justify-center"
              set:html={emailIcon}
            />
          </a>
        </div>
      </div>
    </div>

    <div
      class="order-first md:order-last w-full aspect-square rounded-2xl overflow-hidden border border-line shrink-0"
    >
      <img
        src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT8I_m_kf6iq8JeoiETm7vX9yKD6DfBIdXEJA&s"
        alt="Oluwakayode"
        class="w-full h-full object-cover object-top block"
      />
    </div>
  </div>
</section>

<style>
  .hero-name {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
  }

  .badge {
    color: theme("colors.primary.600");
    background-color: theme("colors.primary.50");
    border-color: theme("colors.primary.200");
  }
  :global(.dark) .badge {
    color: theme("colors.primary.300");
    background-color: transparent;
    border-color: theme("colors.primary.800");
  }
  .badge-dot {
    background-color: theme("colors.primary.400");
    animation: pulse 2.5s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
</style>
