---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  variant?: "desktop" | "mobile";
}

const { headings, variant = "desktop" } = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth <= 4);
---

{
  visibleHeadings.length > 0 && variant === "mobile" && (
    <details class="group border border-line bg-surface font-sans" open>
      <summary class="flex cursor-pointer list-none items-center justify-between bg-ink px-3 py-2 text-[0.95rem] font-semibold text-surface [&::-webkit-details-marker]:hidden">
        Table of contents
        <span
          aria-hidden="true"
          class="h-2 w-2 -rotate-135 border-l border-t border-current transition-transform group-open:rotate-45"
        />
      </summary>

      <nav aria-label="Table of contents">
        <ol class="py-2">
          {visibleHeadings.map((heading) => (
            <li
              data-toc-item
              data-heading-id={heading.slug}
              data-active="false"
              class:list={[
                "border-l border-transparent px-3 py-1.5 text-[0.95rem] leading-snug font-sans transition-colors data-[active=true]:border-primary-500 data-[active=true]:bg-primary-100 dark:data-[active=true]:border-primary-400 dark:data-[active=true]:bg-[color-mix(in_srgb,theme(colors.primary.900)_46%,var(--bg))]",
                heading.depth > 1 && "border-line text-muted",
              ]}
              style={`margin-left: ${(heading.depth - 1) * 0.7}rem`}
            >
              <a
                href={`#${heading.slug}`}
                class="block font-sans text-muted no-underline transition-colors hover:text-primary-500 data-[active=true]:text-primary-600 dark:data-[active=true]:text-primary-200"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

{
  visibleHeadings.length > 0 && variant === "desktop" && (
    <nav
      aria-label="Table of contents"
      class="max-h-[calc(100vh-96px)] overflow-y-auto border border-line bg-surface font-sans"
    >
      <h2 class="border-b border-line px-4 py-2 text-lg font-semibold text-ink">
        Table of contents
      </h2>

      <ol class="py-3">
        {visibleHeadings.map((heading) => (
          <li
            data-toc-item
            data-heading-id={heading.slug}
            data-active="false"
            class:list={[
              "border-l border-transparent px-4 py-1.5 text-[0.95rem] leading-snug font-sans transition-colors data-[active=true]:border-primary-500 data-[active=true]:bg-primary-100 data-[active=true]:text-primary-600 dark:data-[active=true]:border-primary-400 dark:data-[active=true]:bg-[color-mix(in_srgb,theme(colors.primary.900)_46%,var(--bg))] dark:data-[active=true]:text-primary-200",
              heading.depth > 1 && "border-line text-muted",
            ]}
            style={`margin-left: ${(heading.depth - 1) * 0.85}rem`}
          >
            <a
              href={`#${heading.slug}`}
              class="block font-sans text-muted no-underline transition-colors hover:text-primary-500"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script>
  const tocItems = Array.from(
    document.querySelectorAll<HTMLElement>("[data-toc-item]"),
  );
  const tocHeadingIds = Array.from(
    new Set(
      tocItems
        .map((item) => item.dataset.headingId)
        .filter((id): id is string => Boolean(id)),
    ),
  );
  const articleHeadings = tocHeadingIds
    .map((id) => document.getElementById(id))
    .filter((heading): heading is HTMLElement => Boolean(heading));

  function setActiveTocItem(activeId: string) {
    tocItems.forEach((item) => {
      item.dataset.active = String(item.dataset.headingId === activeId);
    });
  }

  function updateActiveTocItem() {
    let activeHeading = articleHeadings[0];

    for (const heading of articleHeadings) {
      if (heading.getBoundingClientRect().top <= 110) {
        activeHeading = heading;
      } else {
        break;
      }
    }

    if (activeHeading?.id) {
      setActiveTocItem(activeHeading.id);
    }
  }

  updateActiveTocItem();
  window.addEventListener("scroll", updateActiveTocItem, { passive: true });
  window.addEventListener("resize", updateActiveTocItem);
</script>
