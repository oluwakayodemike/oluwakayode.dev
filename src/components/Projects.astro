---
import projectsData from "../data/projects.json";
---

<section class="max-w-[640px]">
  <header>
    <h1 class="mb-4 text-2xl font-bold text-ink">Projects</h1>

    <p class="mb-10 text-sm leading-[1.85] text-muted">
      I work on side projects to explore new ideas, learn new tools, and build
      things I actually want to exist. Here are a few I've worked on. You can
      find more on my
      <a
        href="https://github.com/oluwakayodemike"
        target="_blank"
        rel="noopener noreferrer"
        class="text-ink underline underline-offset-4 transition-colors hover:text-muted"
        >GitHub</a
      >.
    </p>
  </header>

  {
    projectsData && projectsData.length > 0 ? (
      <ul role="list" class="divide-y divide-line">
        {projectsData.map((project) => (
          <li class="group py-6 first:pt-0 last:pb-0">
            <article class="flex items-start justify-between gap-4">
              <div class="min-w-0 flex-1">
                <header class="mb-1.5 flex items-baseline gap-2">
                  <h2 class="text-sm font-bold text-ink transition-colors group-hover:text-ink/80">
                    {project.name}
                  </h2>
                  {project.status && project.status !== "active" && (
                    <span class="rounded-full border border-line bg-muted/5 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-muted">
                      {project.status}
                    </span>
                  )}
                </header>

                <p class="mb-3 text-sm leading-relaxed text-muted">
                  {project.description}
                </p>

                {project.tags && project.tags.length > 0 && (
                  <ul
                    aria-label="Technologies used"
                    class="flex flex-wrap gap-1.5"
                  >
                    {project.tags.map((tag) => (
                      <li class="rounded-md bg-primary-100 px-2 py-0.5 text-xs font-medium text-primary-700 dark:bg-primary-900/40 dark:text-primary-300">
                        {tag}
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              {(project.website_url || project.github_url) && (
                <nav
                  aria-label={`${project.name} links`}
                  class="flex shrink-0 items-center gap-3 pt-0.5"
                >
                  {project.website_url && (
                    <a
                      href={project.website_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`Visit ${project.name} live site`}
                      class="text-muted transition-all hover:scale-110 hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded"
                    >
                      <span class="sr-only">Live Site</span>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                      </svg>
                    </a>
                  )}
                  {project.github_url && (
                    <a
                      href={project.github_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`View ${project.name} source on GitHub`}
                      class="text-muted transition-all hover:scale-110 hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded"
                    >
                      <span class="sr-only">GitHub Repository</span>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                      </svg>
                    </a>
                  )}
                </nav>
              )}
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <div class="rounded-lg border border-line border-dashed p-8 text-center">
        <p class="text-sm text-muted">
          More projects coming soon. Check out my GitHub in the meantime!
        </p>
      </div>
    )
  }
</section>
