---
import type { CollectionEntry } from "astro:content";
import externalLinkIcon from "../../icons/external-link.svg?raw";

export interface Props {
  post: CollectionEntry<"writings">;
}

const {
  post: { data, id },
} = Astro.props;

const href = `/writings/${id}`;
const isExternal = !!data.external_url;
const externalUrl = data.external_url;

const dateObj = new Date(data.date);
const formattedDate = dateObj.toLocaleDateString("en-GB");
---

<article class="group flex flex-col mb-5 last:mb-0">
  <div class="mb-2 flex items-start gap-2">
    <a
      href={href}
      class="flex-1 text-lg font-bold text-ink no-underline hover:underline decoration-line underline-offset-4 decoration-2 decoration-secondary-900 dark:decoration-secondary-400"
    >
      {data.title}
    </a>

    {
      isExternal && externalUrl && (
        <a
          href={externalUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Read ${data.title} on the original site`}
          class="mt-1 inline-flex text-muted transition-colors hover:text-primary-400"
        >
          <span
            class="inline-flex opacity-60 [&>svg]:h-3.5 [&>svg]:w-3.5"
            set:html={externalLinkIcon}
          />
        </a>
      )
    }
  </div>

  {
    data.description && (
      <p class="text-sm leading-relaxed text-muted dark:text-secondary-400 mb-2">
        {data.description}
      </p>
    )
  }

  <div class="flex flex-row items-center justify-between gap-4">
    <div class="flex flex-wrap gap-1.5">
      {
        data.tags &&
          data.tags.map((tag: string) => (
            <span class="bg-primary-200 px-2 py-0.5 text-xs font-medium text-primary-600 dark:bg-secondary-900 dark:text-secondary-300">
              {tag}
            </span>
          ))
      }
    </div>
    <time
      datetime={data.date.toISOString()}
      class="shrink-0 text-sm text-muted"
    >
      {formattedDate}
    </time>
  </div>
</article>
