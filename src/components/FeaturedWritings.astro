---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import externalLinkIcon from "../icons/external-link.svg?raw";

type Writing = CollectionEntry<"writings">;
const allWritings = await getCollection(
  "writings",
  ({ data }: { data: CollectionEntry<"writings">["data"] }) =>
    import.meta.env.PROD ? data.draft !== true : true,
);

const writings: Writing[] = allWritings
  .sort(
    (a: Writing, b: Writing) =>
      b.data.date.valueOf() - a.data.date.valueOf(),
  )
  .slice(0, 5);

function formatDate(date: string | Date) {
  const d = date instanceof Date ? date : new Date(date);
  return d.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });
}
---

<section class="pt-10">
  <span class="mb-3 flex items-center gap-2 text-sm tracking-wide text-muted">
    <span
      class="h-[7px] w-[7px] shrink-0 rounded-full bg-secondary-400 dark:bg-secondary-500"
      aria-hidden="true"></span>
    Writings
  </span>

  <ul role="list" class="">
    {
      writings.map((post: Writing) => {
        const href = post.data.external_url ?? `/writings/${post.id}`;
        const isExternal = !!post.data.external_url;
        return (
          <li class="flex items-baseline gap-5 py-4">
            <time
              datetime={post.data.date.toISOString()}
              class="shrink-0 text-sm tabular-nums text-muted"
            >
              {formatDate(post.data.date)}
            </time>
            <a
              href={href}
              target={isExternal ? "_blank" : "_self"}
              rel={isExternal ? "noopener noreferrer" : ""}
              class="text-sm leading-snug text-ink/80 underline underline-offset-4 transition-colors hover:text-primary-400 flex items-center flex-wrap gap-1"
            >
              {post.data.title}
              {isExternal && (
                <span
                  class="inline-flex opacity-40"
                  aria-label="external link"
                  set:html={externalLinkIcon}
                />
              )}
            </a>
          </li>
        );
      })
    }
  </ul>

  <div class="mt-4 flex justify-end">
    <a
      href="/writings"
      class="text-sm text-muted underline underline-offset-4 transition-colors hover:text-primary-400"
    >
      View all writings →
    </a>
  </div>
</section>
