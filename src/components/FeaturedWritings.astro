---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import externalLinkIcon from "../icons/external-link.svg?raw";

type Writing = CollectionEntry<"writings">;
const allWritings = await getCollection(
  "writings",
  ({ data }: { data: CollectionEntry<"writings">["data"] }) =>
    import.meta.env.PROD ? data.draft !== true : true,
);

const writings: Writing[] = allWritings
  .sort(
    (a: Writing, b: Writing) => b.data.date.valueOf() - a.data.date.valueOf(),
  )
  .slice(0, 5);

function formatDate(date: string | Date) {
  const d = date instanceof Date ? date : new Date(date);
  return d.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });
}
---

<section class="pt-10">
  <span class="mb-3 flex items-center gap-2 text-sm tracking-wide text-muted">
    <span
      class="h-[7px] w-[7px] shrink-0 rounded-full bg-secondary-400 dark:bg-secondary-500"
      aria-hidden="true"></span>
    Writings
  </span>

  <ul role="list" class="">
    {
      writings.map((post: Writing) => {
        const isExternal = !!post.data.external_url;
        const externalUrl = post.data.external_url;
        return (
          <li class="flex items-baseline gap-5 py-4">
            <time
              datetime={post.data.date.toISOString()}
              class="shrink-0 text-sm tabular-nums text-muted"
            >
              {formatDate(post.data.date)}
            </time>
            <div class="flex min-w-0 flex-1 items-start gap-2">
              <a
                href={`/writings/${post.id}`}
                class="min-w-0 text-sm leading-snug text-ink/80 underline underline-offset-4 transition-colors hover:text-primary-400"
              >
                {post.data.title}
              </a>
              {isExternal && externalUrl && (
                <a
                  href={externalUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Read ${post.data.title} on the original site`}
                  class="mt-0.5 inline-flex text-muted transition-colors hover:text-primary-400"
                >
                  <span
                    class="inline-flex opacity-40 [&>svg]:h-3.5 [&>svg]:w-3.5"
                    set:html={externalLinkIcon}
                  />
                </a>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>

  <div class="mt-4 flex justify-end">
    <a
      href="/writings"
      class="text-sm text-muted underline underline-offset-4 transition-colors hover:text-primary-400"
    >
      View all writings →
    </a>
  </div>
</section>
